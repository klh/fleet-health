{
  "openapi": "3.1.0",
  "info": {
    "title": "@fleet/health",
    "version": "0.1.0",
    "description": "The outside-process health verdict sidecar: poll the real target over the network, write the verdict file, serve it."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Compact verdict (compose health hits this)",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "up",
                        "degrading",
                        "down"
                      ]
                    },
                    "check": {
                      "type": "string",
                      "enum": [
                        "http-liveness",
                        "inference-route",
                        "route-catalog"
                      ]
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "interval_ms": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "ok",
                    "state",
                    "check",
                    "target",
                    "interval_ms"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "up",
                        "degrading",
                        "down"
                      ]
                    },
                    "check": {
                      "type": "string",
                      "enum": [
                        "http-liveness",
                        "inference-route",
                        "route-catalog"
                      ]
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "interval_ms": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "ok",
                    "state",
                    "check",
                    "target",
                    "interval_ms"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
