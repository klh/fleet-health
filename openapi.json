                    "recent": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "boolean"
                          },
                          "status": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "at": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          },
                          "trace_id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                          }
                        },
                        "required": [
                          "ok",
                          "status",
                          "ms",
                          "at",
                          "trace_id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "target",
                    "mode",
                    "check",
                    "state",
                    "ok",
                    "stale",
                    "misses",
                    "miss_limit",
                    "last_ok",
                    "latency_ms",
                    "checked_at",
                    "error",
                    "probes",
                    "recent"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
